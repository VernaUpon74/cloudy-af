{
  "name": "cloudy-af",
  "version": "1.18.2",
  "private": true,
  "description": "Configuration Tool for Vape Battery Mods with Arcticfox Firmware.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:native": "npm run sidecar:build && npm run tauri:build -- --no-bundle && mkdir -p builds && cp src-tauri/target/release/cloudy-af builds/cloudy-af",
    "sidecar:build": "cd sidecar && npm install",
    "postinstall": "npm run sidecar:build",
    "sidecar:bundle:linux": "bash scripts/prepare-linux-sidecar.sh",
    "appimage:build": "bash scripts/build-appimage.sh",
    "appimage": "npm run appimage:build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "@tauri-apps/plugin-os": "^2.0.0",
    "highcharts": "^9.0.0",
    "highcharts-draggable-points": "^2.0.5",
    "jquery": "^3.7.1",
    "photonkit": "^0.1.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "vite": "^6.2.0"
  }
}
